/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_VIBRATIONCALCULATOR_DIALOG DIALOGEX 0, 0, 260, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vibration Calculator (SDOF Mass-Spring-Damper)"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Mass (kg):",IDC_STATIC,10,12,80,10
    EDITTEXT        IDC_EDIT_MASS,100,10,140,12,ES_AUTOHSCROLL

    LTEXT           "Stiffness (N/m):",IDC_STATIC,10,30,80,10
    EDITTEXT        IDC_EDIT_STIFFNESS,100,28,140,12,ES_AUTOHSCROLL

    LTEXT           "Damping (N*s/m):",IDC_STATIC,10,48,80,10
    EDITTEXT        IDC_EDIT_DAMPING,100,46,140,12,ES_AUTOHSCROLL

    DEFPUSHBUTTON   "Calculate",IDC_BUTTON_CALC,90,70,80,16

    LTEXT           "Natural Frequency: -- Hz",IDC_STATIC_FN,10,100,240,12
    LTEXT           "Damping Ratio: --",IDC_STATIC_ZETA,10,118,240,12
    LTEXT           "Damped Frequency: -- Hz",IDC_STATIC_FD,10,136,240,12

    PUSHBUTTON      "Close",IDCANCEL,90,160,80,16
END


